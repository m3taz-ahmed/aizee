# Bandit security scanner configuration for aiZee.
# https://bandit.readthedocs.io/en/latest/config.html

# Skip B101 (assert_used) — pytest tests use assert extensively by design.
# Skip B404 (subprocess) — MCP client requires subprocess for stdio transport.
# Skip B603 (subprocess_without_shell_equals_true) — intentional for MCP.
# B608 (hardcoded_sql_expressions) is intentionally absent — the test was
#   removed upstream; listing it errors out under bandit 1.7.10.
skips: ['B101', 'B404', 'B603']

# Exclude test directories and generated files from scanning.
exclude_dirs:
  - "tests"
  - "runtime/tests"
  - "memory/tests"
  - "skills"
  - "tmp"
  - "scratch"
  - "temp"
  - "brain"
  - "state"
  - "__pycache__"
  - ".git"
  - ".github"
  - "graphify-out"

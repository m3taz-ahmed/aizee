# aiZee — Environment Variables Template
# Copy this file to .env and fill in your values.
# .env is loaded by runtime/mcp_client.py for MCP server configuration.

# =============================================================================
# Core aiZee Configuration
# =============================================================================

# Root directory of aiZee (where rules/, skills/, workflows/ live).
# If not set, config.discover_root() will try to find it automatically.
# AIZEE_ROOT=D:\.ai

# Project root for the current project being worked on (optional).
# AGENT_PROJECT_ROOT=

# =============================================================================
# Encryption (at-rest encryption for state/budget.json)
# =============================================================================

# Fernet encryption key for sensitive state files (PRODUCTION RECOMMENDED).
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# AIOS_ENCRYPTION_KEY=

# Alternative: path to a key file OUTSIDE the OS root (survives root switches).
# AIOS_ENCRYPTION_KEY_FILE=/etc/aizee/enc.key

# WARNING: if neither is set, a key is auto-generated at <AIZEE_ROOT>/state/.encryption_key.
# Switching AIZEE_ROOT orphans previously encrypted state — budget.json is then
# quarantined to .corrupt.bak and limits silently reset to defaults (H4).
# AIOS_ENCRYPTION_KEY=plaintext disables encryption entirely (dev only).

# Ed25519/HMAC signing key for audit log entries (production: outside OS root).
# AIZEE_AUDIT_SIGN_KEY=/etc/aizee/audit_sign.pem

# =============================================================================
# Dashboard (web UI for monitoring agents, metrics, budget)
# =============================================================================

# Dashboard is open-access by default (localhost-only, CSRF-protected POSTs).
# Opt into Bearer authentication by setting a token:
# AIZEE_DASHBOARD_TOKEN=your-secure-token-here

# CORS origin whitelist (comma-separated).
# AIZEE_DASHBOARD_ORIGIN=http://127.0.0.1:8080

# Dashboard server settings (AIZEE_* preferred, AGENT_OS_* still accepted for backward compat).
# AIZEE_DASHBOARD_MAX_BODY_SIZE=1048576
# AIZEE_DASHBOARD_RATE_LIMIT=120
# AIZEE_DASHBOARD_RATE_WINDOW=60
# AIZEE_DASHBOARD_RATE_MAX_ENTRIES=10000
# AIZEE_DASHBOARD_ORIGINS=http://127.0.0.1:8080,http://localhost:8080
# AIZEE_DASHBOARD_TRUSTED_PROXIES=
# AIZEE_DASHBOARD_HOST=127.0.0.1
# AGENT_OS_DASHBOARD_MAX_BODY_SIZE=1048576 (legacy)
# AGENT_OS_DASHBOARD_RATE_LIMIT=120 (legacy)
# AGENT_OS_DASHBOARD_RATE_WINDOW=60 (legacy)
# AGENT_OS_HOST=127.0.0.1 (legacy)

# =============================================================================
# Observability (Sentry integration)
# =============================================================================

# Sentry DSN for error tracking (optional).
# SENTRY_DSN=

# Sentry traces sample rate (0.0 to 1.0).
# SENTRY_TRACES_SAMPLE_RATE=0.1

# Sentry environment name.
# SENTRY_ENVIRONMENT=production

# =============================================================================
# Freelance Platform Plugins
# =============================================================================

# --- Upwork ---
UPWORK_CLIENT_ID=
UPWORK_CLIENT_SECRET=

# --- Freelancer ---
FREELANCER_OAUTH_TOKEN=
# FREELANCER_ACCOUNTS=

# --- LinkedIn ---
LINKEDIN_ACCESS_TOKEN=
# LINKEDIN_MCP_TOKEN_PATH=

# --- Fiverr ---
# (Fiverr uses MCP server config, no env vars required)

# =============================================================================
# Graphify (knowledge graph MCP wrapper)
# =============================================================================

# Log file path for graphify wrapper (optional).
# GRAPHIFY_WRAPPER_LOG=

# =============================================================================
# Governed LLM Gateway (runtime/gateway_proxy.py — `aizee gateway serve`)
# =============================================================================

# Provider API keys referenced by gateway.yaml `api_key_env` entries.
# The gateway enforces kernel gates on every outbound LLM request and
# fails over between providers on timeout/429/5xx.
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
# GEMINI_API_KEY=

# Opt-in tool-output compression (RTK/Headroom pattern): collapse repetitive
# boilerplate in large MCP results before they reach the model.
# AIZEE_OUTPUT_FILTER=1

# =============================================================================
# REA (reverse engineering — local source checkout, optional)
# =============================================================================

# Absolute path to a local morluto/rea checkout. When unset, agents resolve
# the sibling `../rea` convention next to the aizee root, then `npx rea-agents`.
# REA_HOME=

# Bring-your-own analysis engines (all optional; static JS/.NET needs none):
# GHIDRA_INSTALL_DIR=
# HOPPER_LAUNCHER_PATH=
# REA_IDA_MCP_CONFIG=
# REA_JADX_MCP_JAR=

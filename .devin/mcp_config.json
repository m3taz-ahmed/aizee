{
  "mcpServers": {
    "aizee": {
      "command": "python",
      "args": ["scripts/aizee_mcp_wrapper.py"]
    },
    "graphify": {
      "command": "python",
      "args": ["scripts/graphify_mcp_wrapper.py"]
    },
    "context7": {
      "command": "npx",
      "args": ["-y", "@upstash/context7-mcp@3.1.0"]
    },
    "spec-workflow": {
      "command": "npx",
      "args": ["-y", "@pimzino/spec-workflow-mcp@2.2.7"]
    }
  }
}

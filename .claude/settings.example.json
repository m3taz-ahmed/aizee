{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Read",
      "Glob",
      "Grep",
      "Bash(pwd)",
      "Bash(ls)",
      "Bash(ls:*)",
      "Bash(cd)",
      "Bash(cd:*)",
      "Bash(git status:*)",
      "Bash(git status)",
      "Bash(git diff:*)",
      "Bash(git diff)",
      "Bash(git log:*)",
      "Bash(git log)",
      "Bash(graphify:*)",
      "Bash(aizee:*)",
      "mcp__context7",
      "mcp__graphify",
      "mcp__aizee__query_rules",
      "mcp__aizee__check_policy",
      "mcp__aizee__search_memory",
      "mcp__aizee__search_memory_vector",
      "mcp__aizee__search_skills",
      "mcp__aizee__get_changelog",
      "mcp__aizee__get_active_context"
    ],
    "ask": [
      "Edit",
      "Write",
      "Bash",
      "mcp__aizee"
    ],
    "deny": [
      "Bash(rm -rf:*)",
      "Bash(git reset --hard:*)",
      "Bash(git checkout .)",
      "Bash(git checkout --:*)",
      "Bash(git clean -fd:*)",
      "Bash(git add -A:*)",
      "Bash(git add -A)",
      "Bash(git add .)",
      "Bash(git push -f:*)",
      "Bash(git push --force:*)",
      "Bash(git stash:*)",
      "Bash(git stash)",
      "Bash(curl -X POST:*)",
      "Bash(curl -X DELETE:*)",
      "Bash(Invoke-WebRequest -Method Post:*)",
      "Bash(Invoke-WebRequest -Method Delete:*)",
      "Bash(node -e:*)",
      "Bash(python -c:*)"
    ]
  },
  "mcpServers": {
    "aizee": {
      "command": "python",
      "args": [
        "scripts/aizee_mcp_wrapper.py"
      ],
      "env": { "PYTHONIOENCODING": "utf-8" }
    },
    "context7": {
      "command": "npx",
      "args": [
        "-y",
        "@upstash/context7-mcp@3.1.0"
      ]
    },
    "graphify": {
      "command": "python",
      "args": [
        "scripts/graphify_mcp_wrapper.py"
      ],
      "env": { "PYTHONIOENCODING": "utf-8" }
    }
  },
  "alwaysAllow": {
    "tools": [
      "Read",
      "read",
      "grep",
      "Glob",
      "view",
      "search",
      "query"
    ],
    "mcpTools": [
      "context7-resolve-library-id",
      "context7-get-library-docs",
      "graphify-query",
      "query_rules",
      "check_policy",
      "search_memory",
      "search_memory_vector",
      "search_skills",
      "get_changelog",
      "get_active_context"
    ]
  }
}
